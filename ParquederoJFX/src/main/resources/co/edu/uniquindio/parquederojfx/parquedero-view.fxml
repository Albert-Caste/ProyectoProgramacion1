<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane prefHeight="455.0"
            prefWidth="817.0"

            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"

            fx:controller="co.edu.uniquindio.parquederojfx.viewController.ParqueaderoViewController">

    <children>

        <Label layoutX="154.0"
               layoutY="33.0"
               text="Bienvenido al Parquedero">

            <font>
                <Font size="24" />
            </font>

        </Label>

        <Button fx:id="btnIniciarServicio"
                layoutX="51.0"
                layoutY="96.0"
                mnemonicParsing="false"
                prefHeight="35.0"
                prefWidth="156.0"
                text="Iniciar Servicio"

                onAction="#onIniciarServicio"/>

        <TableView fx:id="tablaServicio"
                   editable="true"
                   layoutX="334.0"
                   layoutY="181.0"
                   prefHeight="200.0"
                   prefWidth="458.0">

            <columns>

                <TableColumn fx:id="tablaColumnaCliente"
                             prefWidth="74.0"
                             text="Cliente" />

                <TableColumn fx:id="tablaColumnaPlaca"
                             prefWidth="76.0"
                             text="Placa" />

                <TableColumn fx:id="tablaColumnaHoraInicio"
                             prefWidth="75.0"
                             text="Hora inicio" />

                <TableColumn fx:id="tablaColumnaHoraFinal"
                             prefWidth="75.0"
                             text="Hora Final" />

                <TableColumn fx:id="tablaColumnaPagoTotal"
                             prefWidth="119.0"
                             text="Precio Servicio" />

            </columns>

        </TableView>

        <Button fx:id="btTerminarServicio"
                layoutX="349.0"
                layoutY="395.0"
                mnemonicParsing="false"
                prefWidth="156.0"
                text="Terminar Servicio"

                onAction="#onTerminarServicio"/>

        <Button fx:id="btCalcularCosto"
                layoutX="528.0"
                layoutY="395.0"
                mnemonicParsing="false"
                text="Calcular Costo"

                onAction="#onCalcularCosto"/>

        <Button fx:id="btEliminarServicio"
                layoutX="661.0"
                layoutY="395.0"
                mnemonicParsing="false"
                text="Eliminar Servicio"

                onAction="#onEliminarServicio"/>

        <Button fx:id="btGestionMensualidad"
                layoutX="51.0"
                layoutY="146.0"
                mnemonicParsing="false"
                prefHeight="35.0"
                prefWidth="156.0"
                text="Servicio Mensualidad"
                onAction="#onGestionMensualidad"/>

        <Button fx:id="btGestionCliente"
                layoutX="49.0"
                layoutY="202.0"
                mnemonicParsing="false"
                prefHeight="35.0"
                prefWidth="156.0"
                text="Registrar Cliente"
                onAction="#onGestionCliente"/>

        <Button fx:id="btGestionVehiculo"
                layoutX="51.0"
                layoutY="256.0"
                mnemonicParsing="false"
                prefHeight="35.0"
                prefWidth="156.0"
                text="Registrar Vehiculo"
                onAction="#onGestionVehiculo"/>

        <Button fx:id="btGestionAdmin"
                layoutX="49.0"
                layoutY="395.0"
                mnemonicParsing="false"
                text="Admin"/>

        <Button fx:id="btGestionEspacios"
                layoutX="51.0"
                layoutY="311.0"
                mnemonicParsing="false"
                prefHeight="35.0"
                prefWidth="156.0"
                text="Gestion Espacios"
                onAction="#onGestionEspacios"/>

        <Label layoutX="318.0"
               layoutY="87.0"
               prefHeight="26.0"
               prefWidth="74.0"
               text="ID Cliente:" />

        <Label layoutX="318.0"
               layoutY="122.0"
               text="Placa :" />

        <TextField fx:id="txtIdCliente"
                   layoutX="409.0"
                   layoutY="87.0" />

        <TextField fx:id="txtPlacaVehiculo"
                   layoutX="409.0"
                   layoutY="118.0" />

    </children>

</AnchorPane>