<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.parquederojfx.viewController.VehiculoViewController">

    <children>

        <SplitPane dividerPositions="0.515" orientation="VERTICAL" prefHeight="566.0" prefWidth="429.0">

            <items>

                <AnchorPane prefHeight="288.0" prefWidth="401.0">

                    <children>

                        <Pane layoutX="34.0" layoutY="20.0" prefHeight="249.0" prefWidth="360.0">

                            <children>

                                <Label layoutX="223.0" layoutY="24.0" text="Gestión Vehiculos">

                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>

                                </Label>

                                <Label layoutX="41.0" layoutY="58.0" text="Placa:">

                                    <font>
                                        <Font size="18.0" />
                                    </font>

                                </Label>

                                <Label layoutX="41.0" layoutY="92.0" text="Color:">

                                    <font>
                                        <Font size="18.0" />
                                    </font>

                                </Label>

                                <Label layoutX="41.0" layoutY="130.0" text="Tipo:">

                                    <font>
                                        <Font size="18.0" />
                                    </font>

                                </Label>

                                <TextField fx:id="txtPlaca" layoutX="126.0" layoutY="59.0" prefWidth="194.0" promptText="Placa" />

                                <TextField fx:id="txtColor" layoutX="126.0" layoutY="93.0" prefWidth="194.0" promptText="Color" />

                                <ComboBox fx:id="cbTipoCarro" layoutX="126.0" layoutY="129.0" prefWidth="194.0" />

                                <Button fx:id="btRegresar" layoutX="16.0" layoutY="14.0" onAction="#onRegresar" prefHeight="39.0" prefWidth="172.0" text="Regresar al Parqueadero" />
      
                                <Button fx:id="btbAgregarVehiculo" layoutX="102.0" layoutY="236.0" onAction="#onAgregarVehiculo" text="Agregar Vehiculo" />

                            </children>

                        </Pane>

                        <Button fx:id="btnActualizarVehiculo" layoutX="267.0" layoutY="256.0" onAction="#onActualizarVehiculo" text="Actualizar Vehiculo" />

                    </children>

                </AnchorPane>

                <AnchorPane prefHeight="271.0" prefWidth="645.0">

                    <children>

                        <TableView fx:id="tblListVehiculos" layoutX="7.0" layoutY="7.0" prefHeight="206.0" prefWidth="412.0">

                            <columns>

                                <TableColumn fx:id="tbcPlaca" prefWidth="120.0" text="Placa" />

                                <TableColumn fx:id="tbcColor" prefWidth="120.0" text="Color" />

                                <TableColumn fx:id="tbcTipoCarro" prefWidth="120.0" text="Tipo" />

                            </columns>

                        </TableView>

                        <Button fx:id="btnLimpiar" layoutX="93.0" layoutY="223.0" onAction="#onLimpiar" prefWidth="106.0" text="Limpiar" />

                        <Button fx:id="btnEliminar" layoutX="234.0" layoutY="223.0" onAction="#onEliminar" prefWidth="97.0" text="Eliminar" />

                    </children>

                </AnchorPane>

            </items>

        </SplitPane>

    </children>

</AnchorPane>
